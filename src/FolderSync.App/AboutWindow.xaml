<Window x:Class="FolderSync.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gioi thieu FolderSync" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <StackPanel>
        <Border Background="{StaticResource NavyDarkBrush}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="48" Height="48"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="22" FontWeight="Bold">
                        <Run Text="Folder"/><Run Text="Sync" Foreground="{StaticResource CyanBrush}"/>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Margin="20,16,20,8">
            <TextBlock Text="Phan mem dong bo du lieu giua 2 folder: Backup, Mirror, Dong bo 2 chieu."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
            <Border Margin="0,14,0,0" Padding="12,10" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="OwnerText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DeveloperText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CopyrightText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Button Content="Dong" HorizontalAlignment="Right" Padding="20,5" Margin="20,4,20,16" IsDefault="True" IsCancel="True"
                Click="Close_Click"/>
    </StackPanel>
</Window>
