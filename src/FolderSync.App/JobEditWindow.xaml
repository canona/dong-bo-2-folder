<Window x:Class="FolderSync.App.JobEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job dong bo" Height="330" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ten Job:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder Trai:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LeftBox" Margin="0,4"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Chon..." Padding="10,4" Margin="6,4,0,4" Click="BrowseLeft_Click"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder Phai:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="RightBox" Margin="0,4"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Chon..." Padding="10,4" Margin="6,4,0,4" Click="BrowseRight_Click"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Che do:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModeBox" Margin="0,4">
            <ComboBoxItem Content="Backup 1 chieu - khong xoa o dich" Tag="BackupOneWay"/>
            <ComboBoxItem Content="Mirror 1 chieu - dich giong het nguon" Tag="MirrorOneWay"/>
            <ComboBoxItem Content="Dong bo 2 chieu" Tag="TwoWay"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Khi xung dot:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PolicyBox" Margin="0,4">
            <ComboBoxItem Content="Ban moi hon thang (mac dinh)" Tag="NewerWins"/>
            <ComboBoxItem Content="Trai thang" Tag="LeftWins"/>
            <ComboBoxItem Content="Phai thang" Tag="RightWins"/>
            <ComboBoxItem Content="Giu ca hai (ban thua thanh conflict copy)" Tag="KeepBoth"/>
            <ComboBoxItem Content="Hoi thu cong - khong tu dong quyet" Tag="Manual"/>
        </ComboBox>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Luu" Padding="16,6" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Huy" Padding="16,6" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
