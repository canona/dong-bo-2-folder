<Window x:Class="FolderSync.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderSync Mini" Width="360" Height="440" MinWidth="300" MinHeight="220"
        WindowStyle="ToolWindow" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBgBrush}" Closing="Window_Closing">
    <!-- Che do Mini: chi danh sach Job + trang thai + tien trinh + nut Dong bo tung Job.
         Dung CHUNG JobListItem voi cua so chinh nen moi cap nhat hien ngay o ca 2. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavyDarkBrush}" Padding="10,6">
            <DockPanel>
                <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" Content="&#xE718;" FontFamily="Segoe MDL2 Assets"
                              Width="28" Height="24" ToolTip="Ghim tren cung" Checked="Pin_Changed" Unchecked="Pin_Changed"/>
                <Image x:Name="LogoImage" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock Text="FolderSync" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryText" Foreground="#94A3B8" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="Dong bo tat ca" Padding="10,4" Margin="0,0,6,0" Click="SyncAll_Click"/>
            <Button Content="Mo day du" Padding="10,4" Click="Full_Click"/>
        </StackPanel>
        <ListBox x:Name="JobList" Margin="8,8,8,0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="1"
                 BorderBrush="{StaticResource CardBorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Visibility="{Binding AutoVisibility}" Margin="4,0,0,0"
                                        Background="{StaticResource GreenFolderBrush}" CornerRadius="3" Padding="5,0">
                                    <TextBlock Text="{Binding AutoText}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding StatusLine}" Foreground="{Binding StatusBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLine}"/>
                            <ProgressBar Height="6" Margin="0,3,0,0" Minimum="0" Maximum="1000"
                                         Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding ProgressVisibility}"
                                         Foreground="{Binding ProgressBrush}" BorderThickness="0" Background="#E2E8F0"
                                         ToolTip="{Binding ProgressText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Dong bo" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Tag="{Binding}" Click="SyncJob_Click" IsEnabled="{Binding CanSync}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
