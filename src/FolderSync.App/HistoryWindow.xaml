<Window x:Class="FolderSync.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lich su va khoi phuc file" Height="440" Width="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBgBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Xem lich su o:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SideBox" Width="150" SelectionChanged="SideBox_SelectionChanged">
                <ComboBoxItem Content="Folder Trai" Tag="Left" IsSelected="True"/>
                <ComboBoxItem Content="Folder Phai" Tag="Right"/>
            </ComboBox>
            <TextBlock Text="Cac file bi xoa/ghi de duoc giu trong .foldersync_history" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thoi diem luu" Binding="{Binding Stamp}" Width="130"/>
                <DataGridTextColumn Header="Duong dan goc" Binding="{Binding RelativePath}" Width="*"/>
                <DataGridTextColumn Header="Kich thuoc (byte)" Binding="{Binding Size}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Khoi phuc file da chon" Padding="14,6" Margin="0,0,8,0" Click="Restore_Click"/>
            <Button Content="Dong" Padding="14,6" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
