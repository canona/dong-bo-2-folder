<Project>
  <!--
    Thong tin san pham + BAN QUYEN dung chung cho moi project (MSBuild tu nap file nay).
    Hien o: chuot phai file .exe > Properties > Details; hop "Gioi thieu" trong app (doc lai tu metadata, xem AppInfo.cs).
    Doi phien ban: sua <Version> o day VA MyAppVersion trong packaging/FolderSync.iss.
  -->
  <PropertyGroup>
    <Product>FolderSync</Product>
    <Company>VTC Digital</Company>
    <Authors>Canona</Authors>
    <Copyright>Copyright © 2026 VTC Digital. All rights reserved.</Copyright>
    <Description>FolderSync - phan mem dong bo du lieu giua 2 folder. Ban quyen thuoc ve VTC Digital, phat trien thang 10/2026 boi Canona.</Description>
    <Version>0.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Doc bang AssemblyMetadataAttribute (Authors khong duoc ghi vao assembly) -->
    <AssemblyMetadata Include="Developer" Value="Canona" />
    <AssemblyMetadata Include="DevelopedOn" Value="10/2026" />
    <AssemblyMetadata Include="CopyrightOwner" Value="VTC Digital" />
  </ItemGroup>
</Project>
